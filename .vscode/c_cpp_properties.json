{
  "version": 4,
  "configurations": [
    {
      "name": "Qt 5.15 with MinGW",
      "includePath": [
        "${workspaceFolder}/**",
        "${env:USERPROFILE}/anaconda3/Library/include/qt",
        "${env:USERPROFILE}/anaconda3/Library/include/qt/QtCore",
        "${env:USERPROFILE}/anaconda3/Library/include/qt/QtGui",
        "${env:USERPROFILE}/anaconda3/Library/include/qt/QtWidgets"
      ],
      "defines": [
        "QT_WIDGETS_LIB",
        "QT_GUI_LIB",
        "QT_CORE_LIB"
      ],
      "compilerPath": "C:/MinGW/bin/g++.exe",
      "cStandard": "c17",
      "cppStandard": "c++11",
      "intelliSenseMode": "windows-gcc-x86"
    }
  ]
}
